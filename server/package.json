{
  "name": "@mobius-ems/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/jobs/runSeedSuperAdmin.ts",
    "cleanup:demo": "tsx src/jobs/removeDemoData.ts",
    "cleanup:sales-demo": "tsx src/jobs/removeSalesDemoData.ts",
    "backup": "tsx src/jobs/backupDatabase.ts",
    "preflight:tenants": "tsx src/jobs/tenantPreflight.ts",
    "verify:preservation": "tsx src/jobs/verifyMigrationPreservation.ts",
    "restore:migration-metadata": "tsx src/jobs/restoreMigrationMetadata.ts",
    "migrate:tenants": "tsx src/jobs/runTenantMigration.ts",
    "migrate:mongo": "tsx src/jobs/migrateMongoToPostgres.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@eslint/js": "^9.31.0",
    "@mobius-ems/shared": "file:../shared",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.14",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.23.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "eslint": "^9.31.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.2",
    "mongodb": "^7.6.0",
    "mongoose": "^8.16.4",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "read-excel-file": "^9.3.10",
    "tsx": "^4.20.3",

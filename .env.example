NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://mobius:mobius@127.0.0.1:5432/mobius_ems
POSTGRES_MIN_POOL_SIZE=2
POSTGRES_MAX_POOL_SIZE=5
POSTGRES_SSL=false
# One-time source used only by npm run migrate:mongo; remove after cutover.
# MONGODB_MIGRATION_URI=mongodb+srv://username:password@cluster.mongodb.net/mobius_ems
DEFAULT_TENANT_NAME=MobiusEMS
DEFAULT_TENANT_SLUG=mobius-ems
PLATFORM_ADMIN_EMAILS=owner@example.com
PLATFORM_OWNER_NAME=Platform Owner
PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_PASSWORD=replace-with-a-strong-owner-password
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=sales@example.com
BREVO_SENDER_NAME=MobiusEMS
BREVO_REPLY_TO_EMAIL=sales@example.com
BREVO_WEBHOOK_TOKEN=replace-with-a-random-secret-at-least-24-characters
EMAIL_AUTOMATION_ENABLED=true
EMAIL_AUTOMATION_BATCH_SIZE=20
EMAIL_AUTOMATION_DAILY_LIMIT=250
# Optional Gmail integration. Leave commented until Google OAuth is configured.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=configure-on-server-only
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/email-automation/google/callback
GMAIL_DAILY_LIMIT=100
AI_PROVIDER=groq
AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_BASE_URL=
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=45000
AI_COMPANY_KNOWLEDGE=
VOICE_PYTHON_COMMAND=python3
VOICE_WHISPER_MODEL=small
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_WHISPER_LANGUAGE=
VOICE_TRANSCRIPTION_TIMEOUT_MS=180000
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ATTENDANCE_OFFICE_NAME=Shivnath Business Centre, Raipur
ATTENDANCE_OFFICE_LATITUDE=21.251413450117614
ATTENDANCE_OFFICE_LONGITUDE=81.70943785263866
ATTENDANCE_RADIUS_METERS=300
ATTENDANCE_MAX_ACCURACY_METERS=200


# Optional isolated Whalexy demo company
WHALEXY_DEMO_ENABLED=false

{
  "name": "mobius-ems",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "postinstall": "npm run build",
    "predev": "npm run build -w shared",
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "lint": "npm run lint -w client && npm run lint -w server",
    "pretypecheck": "npm run build -w shared",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w client && npm run typecheck -w server",
    "seed": "npm run seed -w server",
    "seed:whalexy-demo": "npm run seed:whalexy-demo -w server --",
    "cleanup:demo": "npm run cleanup:demo -w server",
    "cleanup:sales-demo": "npm run cleanup:sales-demo -w server",
    "backup": "npm run backup -w server --",
    "preflight:tenants": "npm run preflight:tenants -w server",
    "verify:preservation": "npm run verify:preservation -w server --",
    "migrate:tenants": "npm run migrate:tenants -w server --",
    "migrate:mongo": "npm run migrate:mongo -w server",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "overrides": {
    "express": {
      "qs": "6.16.0"
    },
    "body-parser": {
      "qs": "6.16.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qs": "^6.16.0"
  }
}

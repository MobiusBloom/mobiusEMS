# ==============================================================================
# MobiusEMS Production Environment Variables
# For Domain: https://ems.mobiusbloom.com
# ==============================================================================

# Core Node Environment
NODE_ENV=production
PORT=5000
CLIENT_URL=https://ems.mobiusbloom.com
# Optional Gmail integration; configure server-side after Google OAuth setup.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=configure-on-server-only
# GOOGLE_REDIRECT_URI=https://ems.mobiusbloom.com/api/v1/email-automation/google/callback
GMAIL_DAILY_LIMIT=100

# Database (PostgreSQL connection URI)
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/mobius_ems
POSTGRES_MIN_POOL_SIZE=2
POSTGRES_MAX_POOL_SIZE=5
POSTGRES_SSL=true

# Default Organization & Tenancy
DEFAULT_TENANT_NAME=MobiusEMS
DEFAULT_TENANT_SLUG=mobiusbloom

# Platform Owner & Initial Admin
PLATFORM_ADMIN_EMAILS=admin@mobiusbloom.com
PLATFORM_OWNER_NAME=Platform Owner
PLATFORM_OWNER_EMAIL=admin@mobiusbloom.com
PLATFORM_OWNER_PASSWORD=ReplaceWithStrongPassword123!

# Security & Authentication (Generate 32+ random characters each)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-for-access
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=

# Optional Services
BREVO_SENDER_NAME=MobiusEMS
BREVO_SENDER_EMAIL=admin@mobiusbloom.com
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
